{
  "name": "bbs-libman",
  "version": "1.3.0",
  "description": "BB's Library Manager for 3D model and game asset downloads",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --inspect=5858",
    "build": "electron-builder",
    "test": "node --test",
    "lint": "eslint .",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check": "npm run lint && npm test && npm run audit:prod"
  },
  "build": {
    "appId": "com.bbs-libman.app",
    "productName": "BB's LibMan",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "publish": {
      "provider": "github",
      "owner": "BunBnnuy",
      "repo": "BBLM"
    }
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "cheerio": "^1.2.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "sharp": "^0.35.0",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1",
    "eslint": "^9.33.0"
  }
}
