{
  "name": "bbs-libman",
  "version": "1.6.1",
  "description": "BB's Library Manager for 3D model and game asset downloads",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/dev.js",
    "dev:electron": "electron . --inspect=5858",
    "dev:web": "node scripts/dev.js --web-only",
    "web": "node server.js --port 47823",
    "web:public": "node server.js --host 0.0.0.0 --port 80",
    "build": "electron-builder",
    "test": "node --test",
    "lint": "eslint .",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check": "npm run lint && npm test && npm run audit:prod"
  },
  "build": {
    "appId": "com.bbs-libman.app",
    "productName": "BB's LibMan",
    "files": [
      "**/*",
      "!booth-forum-link-extension{,/**/*}",
      "!AGENTS.md",
      "!.claude{,/**/*}",
      "!test{,/**/*}",
      "!plan.md",
      "!scripts{,/**/*}",
      "!data{,/**/*}"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "publish": {
      "provider": "github",
      "owner": "BunBnnuy",
      "repo": "BBLM"
    }
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "overrides": {
    "fast-uri": "^4.2.3",
    "undici": "^8.12.3"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "sharp": "^0.35.5",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1",
    "eslint": "^9.33.0",
    "tar": "^7.5.16"
  }
}
